# Service account used by api/food-images.js to list images from a shared
# Google Drive folder. Set the real values in Vercel's Project Settings ->
# Environment Variables (never commit a filled-in .env.local).
#
# Share the Drive folder with the service account as EDITOR (not Viewer) so it
# can cache resolved place names back onto each file (appProperties). Viewer
# still works — geocoding just re-runs on every cold start instead of once.

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# Optional. If set, a photo with GPS EXIF but no place name in its filename
# gets its place filled in by reverse-geocoding the coordinates.
GOOGLE_MAPS_API_KEY=your-maps-geocoding-api-key

# Spotify app credentials, used by api/spotify.js for the "Outside Work" panel.
# From https://developer.spotify.com/dashboard -> your app -> Settings.
# Register this Redirect URI there: http://127.0.0.1:5173/callback
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Your own long-lived token, so the site can read YOUR listening activity.
# Don't write this by hand: run `npm run dev`, open
# http://127.0.0.1:5173/api/spotify/login, approve, and it's saved to
# .env.local automatically. Copy the same value into Vercel for production.
SPOTIFY_REFRESH_TOKEN=

# Optional. Only if you registered a different redirect URI than the one above.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Overwatch 2 stats for the "Off the clock" panel, served by api/overwatch.js.
# Blizzard has no official API; this reads the community OverFast API
# (https://overfast-api.tekrop.fr), which needs no key or login.
# Whose career to show (Name#1234 or Name-1234). The profile must be public in
# game: Options -> Social -> Career Profile Visibility -> Public.
OVERWATCH_BATTLETAG=YourName-1234

# Optional. Only if you run your own OverFast instance instead of the public one.
# OVERFAST_API_URL=https://overfast-api.tekrop.fr

# Delivery for the "text me" chat card (api/contact.js). Without a key the card
# still plays, but answers can't be delivered and it shows a mailto fallback.
# Free key from https://resend.com -> API Keys.
RESEND_API_KEY=

# CONTACT_FROM must be a verified Resend sender. Resend's shared
# onboarding@resend.dev sender is SANDBOX ONLY: it delivers to the address that
# owns the Resend account and 403s on every other recipient, so the card fails
# for every visitor until you verify a domain.
#
# To take it live: Resend -> Domains -> Add Domain, publish the DKIM/SPF records
# it gives you, wait for "Verified", then set CONTACT_FROM to an address on that
# domain. CONTACT_TO can then be any inbox you want.
CONTACT_TO=ron.maranan01@gmail.com
CONTACT_FROM=Portfolio <hello@your-verified-domain.com>
