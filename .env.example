# Service account used by api/food-images.js to list images from a shared
# Google Drive folder. Set the real values in Vercel's Project Settings ->
# Environment Variables (never commit a filled-in .env.local).
#
# Share the Drive folder with the service account as EDITOR (not Viewer) so it
# can cache resolved place names back onto each file (appProperties). Viewer
# still works — geocoding just re-runs on every cold start instead of once.

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# Optional. If set, a photo with GPS EXIF but no place name in its filename
# gets its place filled in by reverse-geocoding the coordinates.
GOOGLE_MAPS_API_KEY=your-maps-geocoding-api-key
