# Service account shared by api/food-images.js and api/resume.js to read from
# Google Drive folders. Set the real values in Vercel's Project Settings ->
# Environment Variables (never commit a filled-in .env.local).
#
# The same service account can read any number of unrelated folders — access
# is granted per-folder via Drive sharing, not by anything below. Share EACH
# folder with this service account's email individually.

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Share the food photo folder with the service account as EDITOR (not Viewer)
# so it can cache resolved place names back onto each file (appProperties).
# Viewer still works — geocoding just re-runs on every cold start instead of once.
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# Share this folder with the service account as VIEWER. api/resume.js serves
# whichever PDF's filename encodes the latest date — name each file
# "Resume-M-D-YYYY.pdf" (zero-padding optional, e.g. "Resume-9-2-2026.pdf" or
# "Resume-09-02-2026.pdf"). Drop a new PDF in with a newer date to update the
# site's Resume link, no code change or deploy needed. Old versions can stay
# in the folder for history.
GOOGLE_DRIVE_RESUME_FOLDER_ID=your-resume-drive-folder-id

# Optional. If set, a photo with GPS EXIF but no place name in its filename
# gets its place filled in by reverse-geocoding the coordinates.
GOOGLE_MAPS_API_KEY=your-maps-geocoding-api-key

# Spotify app credentials, used by api/spotify.js for the "Outside Work" panel.
# From https://developer.spotify.com/dashboard -> your app -> Settings.
# Register this Redirect URI there: http://127.0.0.1:5173/callback
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Your own long-lived token, so the site can read YOUR listening activity.
# Don't write this by hand: run `npm run dev`, open
# http://127.0.0.1:5173/api/spotify/login, approve, and it's saved to
# .env.local automatically. Copy the same value into Vercel for production.
SPOTIFY_REFRESH_TOKEN=

# Optional. Only if you registered a different redirect URI than the one above.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Overwatch 2 stats for the "Off the clock" panel, served by api/overwatch.js.
# Blizzard has no official API; this reads the community OverFast API
# (https://overfast-api.tekrop.fr), which needs no key or login.
# Whose career to show (Name#1234 or Name-1234). The profile must be public in
# game: Options -> Social -> Career Profile Visibility -> Public.
OVERWATCH_BATTLETAG=YourName-1234

# Optional. Only if you run your own OverFast instance instead of the public one.
# OVERFAST_API_URL=https://overfast-api.tekrop.fr

# Delivery for the "text me" chat card (api/contact.js). Without a key the card
# still plays, but answers can't be delivered and it shows a mailto fallback.
# Free key from https://resend.com -> API Keys.
RESEND_API_KEY=

# CONTACT_FROM must be an address on a domain verified in Resend. Resend's
# shared onboarding@resend.dev sender is SANDBOX ONLY: it delivers to the
# address that owns the Resend account and 403s on every other recipient, so
# the card fails for every visitor while it's in use.
#
# ronielle.tech is registered through Vercel, so its DNS lives in the Vercel
# dashboard: Resend -> Domains -> Add Domain -> ronielle.tech, then copy the
# DKIM/SPF records into Vercel -> Domains -> ronielle.tech -> DNS Records.
# Wait for Resend to read "Verified" before expecting delivery.
CONTACT_TO=ron.maranan01@gmail.com
CONTACT_FROM=Portfolio <hello@ronielle.tech>
